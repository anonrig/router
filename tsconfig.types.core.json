{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "skipLibCheck": true,
    "paths": {
      "fast-router-history": ["./packages/history/src/index.ts"],
      "fast-router-core": ["./packages/router-core/src/index.ts"],
      "fast-router-core/is-server": ["./packages/router-core/src/is-server.ts"],
      "fast-router-core/utils": ["./packages/router-core/src/utils.ts"],
      "fast-router-core/ssr/serializer/transformer": [
        "./packages/router-core/src/ssr/serializer/transformer-types.ts"
      ],
      "@tanstack/history": ["./packages/history/src/index.ts"],
      "@tanstack/router-core": ["./packages/router-core/src/index.ts"],
      "@tanstack/router-core/isServer": ["./packages/router-core/src/is-server.ts"],
      "@tanstack/router-core/utils": ["./packages/router-core/src/utils.ts"],
      "@tanstack/router-core/ssr/serializer/transformer": [
        "./packages/router-core/src/ssr/serializer/transformer-types.ts"
      ]
    }
  },
  "include": [
    "packages/history",
    "packages/router-core/src/**/*.ts",
    "packages/router-core/src/ssr/serializer/transformer-types.ts",
    "tests/tanstack-core-types"
  ],
  "exclude": ["packages/router-core/src/ssr/**"]
}
