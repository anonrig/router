{
  "name": "@anonrig/router",
  "version": "0.0.0",
  "private": true,
  "description": "A faster React router with the TanStack Router API",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "pnpm -r --filter './packages/*' run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:tanstack": "vitest run --config vitest.tanstack.config.ts",
    "test:tanstack-core": "vitest run --config vitest.tanstack.config.ts tests/tanstack-core",
    "bench": "vitest bench --run benches",
    "typecheck": "tsc -b --pretty false",
    "test:types": "tsc -p tsconfig.types.json --pretty false && tsc -p tsconfig.types.core.json --pretty false",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@types/node": "^22.13.10",
    "@types/react": "~19.2.0",
    "@types/react-dom": "~19.2.0",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^26.0.0",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "oxlint-tsgolint": "^7.0.2001",
    "react": "~19.2.0",
    "react-dom": "~19.2.0",
    "typescript": "^5.8.2",
    "vite": "^6.2.0",
    "vitest": "^3.0.8",
    "zod": "^3.24.2"
  },
  "packageManager": "pnpm@10.15.0"
}
