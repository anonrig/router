{
  "compilerOptions": {
    "target": "ES2024",
    "lib": ["ES2024", "ESNext.Error", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": false,
    "skipLibCheck": true,
    "types": ["node"],
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": false,
    "resolveJsonModule": true,
    "noEmit": true,
    "paths": {
      "fast-router-history": ["./packages/history/src/index.ts"],
      "fast-router-core": ["./packages/router-core/src/index.ts"],
      "fast-router-react": ["./packages/react-router/src/index.ts"],
      "fast-router-generator": ["./packages/router-generator/src/index.ts"],
      "fast-router-generator/vite": ["./packages/router-generator/src/vite.ts"],
      "@tanstack/history": ["./packages/history/src/index.ts"],
      "@tanstack/router-core": ["./packages/router-core/src/index.ts"],
      "@tanstack/react-router": ["./packages/react-router/src/index.ts"],
      "fast-router-core/is-server": ["./packages/router-core/src/is-server.ts"],
      "fast-router-core/ssr/server": ["./packages/router-core/src/ssr/server.ts"],
      "fast-router-core/ssr/client": ["./packages/router-core/src/ssr/client.ts"],
      "@tanstack/router-core/isServer": ["./packages/router-core/src/is-server.ts"],
      "@tanstack/react-store": ["./packages/react-router/src/react-store.ts"],
      "@tanstack/router-core/utils": ["./packages/router-core/src/utils.ts"],
      "@tanstack/router-core/ssr/serializer/transformer": [
        "./packages/router-core/src/ssr/serializer/transformer-types.ts"
      ],
      "fast-router-core/ssr/serializer/transformer": [
        "./packages/router-core/src/ssr/serializer/transformer-types.ts"
      ],
      "@tanstack/router-core/ssr/server": ["./packages/router-core/src/ssr/server.ts"],
      "@tanstack/router-core/ssr/client": ["./packages/router-core/src/ssr/client.ts"],
      "@tanstack/router-core/ssr/ssr-match-id": ["./packages/router-core/src/ssr/ssr-match-id.ts"],
      "@tanstack/react-router/ssr/renderRouterToStream": [
        "./packages/react-router/src/ssr/render-router-to-stream.tsx"
      ],
      "@tanstack/react-router/ssr/RouterClient": [
        "./packages/react-router/src/ssr/router-client.tsx"
      ],
      "@tanstack/react-router/ssr/server": ["./packages/react-router/src/ssr/server.ts"],
      "@tanstack/react-router/ssr/client": ["./packages/react-router/src/ssr/client.ts"],
      "@tanstack/react-router/ClientOnly": ["./packages/react-router/src/client-only.tsx"],
      "@tanstack/react-router/Scripts": ["./packages/react-router/src/scripts.tsx"]
    }
  },
  "include": ["packages", "benches", "tests"]
}
