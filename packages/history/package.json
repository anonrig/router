{
  "name": "speedy-router-history",
  "version": "0.1.1",
  "description": "Browser, hash, and memory history for speedy-router.",
  "homepage": "https://github.com/anonrig/router#readme",
  "bugs": {
    "url": "https://github.com/anonrig/router/issues"
  },
  "license": "MIT",
  "author": "Yagiz Nizipli",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anonrig/router.git",
    "directory": "packages/history"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "node --disable-warning=ExperimentalWarning --experimental-transform-types --import ../../scripts/register-ts.mjs ../../scripts/build-packages.ts --package history"
  },
  "engines": {
    "node": ">=24"
  }
}
