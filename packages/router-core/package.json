{
  "name": "speedy-router-core",
  "version": "0.1.21",
  "description": "Matcher, navigation, loaders, and search params for speedy-router.",
  "homepage": "https://github.com/anonrig/router#readme",
  "bugs": {
    "url": "https://github.com/anonrig/router/issues"
  },
  "license": "MIT",
  "author": "Yagiz Nizipli",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anonrig/router.git",
    "directory": "packages/router-core"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "sideEffects": [
    "./dist/ssr/register-load-server.js",
    "./dist/ssr/server.js",
    "./dist/warm.js"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./is-server": {
      "types": "./dist/is-server.d.ts",
      "default": "./dist/is-server.js"
    },
    "./isServer": {
      "types": "./dist/is-server.d.ts",
      "default": "./dist/is-server.js"
    },
    "./new-process-route-tree": {
      "types": "./dist/new-process-route-tree.d.ts",
      "default": "./dist/new-process-route-tree.js"
    },
    "./scroll-restoration-script": {
      "types": "./dist/scroll-restoration-script/server.d.ts",
      "browser": "./dist/scroll-restoration-script/client.js",
      "default": "./dist/scroll-restoration-script/server.js"
    },
    "./ssr/server": {
      "types": "./dist/ssr/server.d.ts",
      "default": "./dist/ssr/server.js"
    },
    "./ssr/client": {
      "types": "./dist/ssr/client.d.ts",
      "default": "./dist/ssr/client.js"
    },
    "./ssr/ssr-match-id": {
      "types": "./dist/ssr/ssr-match-id.d.ts",
      "default": "./dist/ssr/ssr-match-id.js"
    },
    "./ssr/serializer/transformer": {
      "types": "./dist/ssr/serializer/transformer-types.d.ts",
      "default": "./dist/ssr/serializer/transformer-types.js"
    },
    "./utils": {
      "types": "./dist/utils.d.ts",
      "default": "./dist/utils.js"
    },
    "./warm": {
      "types": "./dist/warm.d.ts",
      "default": "./dist/warm.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "node --disable-warning=ExperimentalWarning --experimental-transform-types --import ../../scripts/register-ts.mjs ../../scripts/build-packages.ts --package router-core"
  },
  "dependencies": {
    "cookie-es": "^3.1.1",
    "seroval": "^1.6.2",
    "seroval-plugins": "^1.6.2",
    "speedy-router-history": "workspace:*"
  },
  "engines": {
    "node": ">=24"
  }
}
