{
  "name": "speedy-router",
  "version": "0.1.21",
  "description": "The TanStack Router API. Rebuilt for the hot path.",
  "homepage": "https://github.com/anonrig/router#readme",
  "bugs": {
    "url": "https://github.com/anonrig/router/issues"
  },
  "license": "MIT",
  "author": "Yagiz Nizipli",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anonrig/router.git",
    "directory": "packages/react-router"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "sideEffects": [
    "./dist/ssr/server.js"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "react-server": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.rsc.js"
      },
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./ssr/server": {
      "types": "./dist/ssr/server.d.ts",
      "default": "./dist/ssr/server.js"
    },
    "./ssr/client": {
      "types": "./dist/ssr/client.d.ts",
      "default": "./dist/ssr/client.js"
    },
    "./ssr/router-client": {
      "types": "./dist/ssr/router-client.d.ts",
      "default": "./dist/ssr/router-client.js"
    },
    "./ssr/RouterClient": {
      "types": "./dist/ssr/router-client.d.ts",
      "default": "./dist/ssr/router-client.js"
    },
    "./ssr/render-router-to-stream": {
      "types": "./dist/ssr/render-router-to-stream.d.ts",
      "default": "./dist/ssr/render-router-to-stream.js"
    },
    "./ssr/renderRouterToStream": {
      "types": "./dist/ssr/render-router-to-stream.d.ts",
      "default": "./dist/ssr/render-router-to-stream.js"
    },
    "./ClientOnly": {
      "types": "./dist/client-only.d.ts",
      "default": "./dist/client-only.js"
    },
    "./Scripts": {
      "types": "./dist/scripts.d.ts",
      "default": "./dist/scripts.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "node --disable-warning=ExperimentalWarning --experimental-transform-types --import ../../scripts/register-ts.mjs ../../scripts/build-packages.ts --package react-router"
  },
  "dependencies": {
    "speedy-router-core": "workspace:*",
    "speedy-router-history": "workspace:*"
  },
  "peerDependencies": {
    "react": "~19.2.0",
    "react-dom": "~19.2.0"
  },
  "engines": {
    "node": ">=24"
  }
}
