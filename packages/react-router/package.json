      "default": "./src/index.ts"
    },
    "./ssr/server": "./src/ssr/server.ts",
    "./ssr/client": "./src/ssr/client.ts",
    "./ssr/router-client": "./src/ssr/router-client.tsx",
    "./ssr/RouterClient": "./src/ssr/router-client.tsx",
    "./ssr/render-router-to-stream": "./src/ssr/render-router-to-stream.tsx",
    "./ssr/renderRouterToStream": "./src/ssr/render-router-to-stream.tsx",
    "./ClientOnly": "./src/client-only.tsx",
    "./Scripts": "./src/scripts.tsx",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "echo 'source package'"
  },
  "dependencies": {
    "speedy-router-core": "workspace:*",
    "speedy-router-history": "workspace:*"
  },
  "peerDependencies": {
    "react": "~19.2.0",
    "react-dom": "~19.2.0"
  },
  "engines": {
    "node": ">=24"
  }
