{
  "$schema": "https://unpkg.com/knip@6/schema-jsonc.json",
  // Workspace package consumed through @tanstack/react-router path aliases.
  "ignoreDependencies": ["speedy-router"],
  "treatConfigHintsAsErrors": true,
  "ignoreIssues": {
    // Public / TanStack-compatible library surface. Unused files and
    // dependencies still fail; unused named exports in src do not.
    "packages/**/src/**": ["exports", "types", "duplicates", "nsExports", "nsTypes", "enumMembers"],
    // Vendored TanStack tests keep helpers that this repo does not call.
    "tests/**": ["exports", "types", "duplicates"],
    // Optional peer: the vite export is type-only until an app uses the plugin.
    "packages/router-plugin/package.json": ["optionalPeerDependencies"],
  },
  "workspaces": {
    ".": {
      "entry": [
        "scripts/**/*.{ts,mjs}",
        "benches/**/*.{ts,tsx}",
        "tests/**/*.{test,spec}.{ts,tsx}",
        "tests/**/*.test-d.{ts,tsx}",
        "tests/tanstack/setup-tests.tsx",
      ],
    },
    "packages/history": {
      "entry": ["src/index.ts"],
    },
    "packages/router-core": {
      "entry": [
        "src/index.ts",
        "src/is-server.ts",
        "src/warm.ts",
        "src/new-process-route-tree.ts",
        "src/utils.ts",
        "src/ssr/server.ts",
        "src/ssr/register-load-server.ts",
        "src/ssr/client.ts",
        "src/ssr/ssr-match-id.ts",
        "src/ssr/serializer/transformer-types.ts",
        "src/scroll-restoration-script/client.ts",
        "src/scroll-restoration-script/server.ts",
        "src/scroll-restoration-inline.ts",
        "src/ssr/tsr-script.ts",
      ],
    },
    "packages/react-router": {
      "entry": [
        "src/index.ts",
        "src/index.rsc.ts",
        "src/warm.ts",
        "src/client-only.tsx",
        "src/scripts.tsx",
        "src/ssr/server.ts",
        "src/ssr/client.ts",
        "src/ssr/router-client.tsx",
        "src/ssr/render-router-to-stream.tsx",
      ],
    },
    "packages/router-plugin": {
      "entry": ["src/index.ts", "src/vite.ts"],
    },
  },
}
