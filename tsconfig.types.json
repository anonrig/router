{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "skipLibCheck": true,
    "paths": {
      "@anonrig/history": ["./packages/history/src/index.ts"],
      "@anonrig/router-core": ["./packages/router-core/src/index.ts"],
      "@anonrig/router-core/isServer": ["./packages/router-core/src/isServer.ts"],
      "@anonrig/router-core/ssr/server": ["./packages/router-core/src/ssr/server.ts"],
      "@anonrig/router-core/ssr/client": ["./packages/router-core/src/ssr/client.ts"],
      "@anonrig/react-router": ["./packages/react-router/src/index.ts"],
      "@anonrig/react-router/ssr/server": ["./packages/react-router/src/ssr/server.ts"],
      "@anonrig/react-router/ssr/client": ["./packages/react-router/src/ssr/client.ts"],
      "@tanstack/history": ["./packages/history/src/index.ts"],
      "@tanstack/router-core": ["./packages/router-core/src/index.ts"],
      "@tanstack/router-core/isServer": ["./packages/router-core/src/isServer.ts"],
      "@tanstack/router-core/ssr/server": ["./packages/router-core/src/ssr/server.ts"],
      "@tanstack/router-core/ssr/client": ["./packages/router-core/src/ssr/client.ts"],
      "@tanstack/react-router": ["./packages/react-router/src/index.ts"],
      "@tanstack/react-router/ssr/RouterClient": [
        "./packages/react-router/src/ssr/RouterClient.tsx"
      ],
      "@tanstack/react-store": ["./packages/react-router/src/react-store.ts"],
      "@tanstack/router-core/utils": ["./packages/router-core/src/utils.ts"],
      "@anonrig/router-core/utils": ["./packages/router-core/src/utils.ts"],
      "@tanstack/router-core/ssr/serializer/transformer": [
        "./packages/router-core/src/ssr/serializer/transformer-types.ts"
      ],
      "@anonrig/router-core/ssr/serializer/transformer": [
        "./packages/router-core/src/ssr/serializer/transformer-types.ts"
      ]
    }
  },
  "include": [
    "packages/history",
    "packages/router-core/src/**/*.ts",
    "packages/router-core/src/ssr/serializer/transformer-types.ts",
    "packages/react-router/src/**/*.{ts,tsx}",
    "tests/tanstack-types"
  ],
  "exclude": ["packages/router-core/src/ssr/**", "packages/react-router/src/ssr/**"]
}
